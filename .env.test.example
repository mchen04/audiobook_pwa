# Copy to .env.test (gitignored) and run: node scripts/test-db.mjs
#
# Every test suite reads .env.test, never .env.local. Nothing here is a real
# secret: the database is the throwaway container in docker-compose.yml and the
# auth secret signs sessions that only ever exist on this machine.
#
# The hosted (Neon) connection string must NEVER be placed in this file or in
# .env.test — scripts/lib/assert-local-database.mjs refuses to run against it.

# Matches docker-compose.yml: user hark, password hark, database hark_test,
# published on the deliberately unusual host port 54329.
DATABASE_URL=postgresql://hark:hark@127.0.0.1:54329/hark_test

# Local-only session signing key. Must be at least 32 characters.
BETTER_AUTH_SECRET=hark-local-test-secret-not-a-real-secret-0000

# Must exactly match PLAYWRIGHT_BASE_URL, or WebKit rejects the auth cookie.
BETTER_AUTH_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Credential account created by `node scripts/test-db.mjs seed`, for suites that
# want to sign in instead of registering. Password must be >= 12 characters.
HARK_TEST_ACCOUNT_EMAIL=e2e@hark.test
HARK_TEST_ACCOUNT_PASSWORD=Hark-Local-E2E-2026!
HARK_TEST_ACCOUNT_NAME=Hark Test Account

# Password-reset mail is written to .data/mail instead of being sent.
ALLOW_LOCAL_MAIL_CAPTURE=1
